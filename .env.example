# Copie para .env e preencha. Nunca commite o .env.
APP_ENV=development            # development | production
LLM_PROVIDER=anthropic         # anthropic | openai_compat | ollama | gemini | fake (gemini bloqueado em production)
LLM_MODEL=claude-haiku-4-5     # o mais barato da Anthropic; em ollama/gemini use o nome do modelo deles
LLM_MAX_TOKENS=1024            # teto de tokens por resposta (controle de custo)
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
LLM_MAX_CONCURRENCY=8
LLM_MAX_RETRIES=3
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=
PROFESSOR_PASSWORD_HASH=
RETENCAO_DIAS=60
COBERTURA_MINIMA=0.7
LOG_CONVERSAS=false
